{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flash",
        "width": 1120,
        "height": 700,
        "minWidth": 780,
        "minHeight": 440,
        "visible": false,
        "decorations": false
      },
      {
        "label": "panel",
        "title": "Flash",
        "url": "panel.html",
        "width": 360,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true,
        "visibleOnAllWorkspaces": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ]
  }
}
