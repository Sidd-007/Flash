{
  "manifest_version": 3,
  "name": "RDM Download Manager",
  "version": "0.1.0",
  "description": "Send downloads and HLS video streams to RDM, the download manager on your Mac.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies",
    "webRequest",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "common.js",
        "youtube.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "RDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rdm@siddhant.local",
      "strict_min_version": "115.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dialog.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
